function threeSumClosest(nums, target){
nums.sort((a, b) => a - b);

let ns=nums[0]+nums[1]+nums[2];

for(i=0;i<nums.length-2;i++){
  let left=i+1;
  let right=nums.length-1;
  while(left<right){
    
    let cs=nums[i]+nums[left]+nums[right];
    if(Math.abs(cs-target)<(Math.abs(ns-target))){
      ns=cs}
      if(cs===target){
        return cs;
      }
      else if(cs<target){
        left++
      }
      else{
        right--
      }
    }
  }
  return ns
}
console.log(threeSumClosest([-1,2,1,-4], 1));
