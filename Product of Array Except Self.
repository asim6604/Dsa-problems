function sufixProducts(nums) {
    let sufix = new Array(nums.length);
    sufix[nums.length-1] = 1; // nothing before index 0
    
    for (let i = nums.length-2; i >=0; i--) {
      
        sufix[i]=sufix[i+1]*nums[i+1]
      
    }
    
    return sufix;
}
function prefixProducts(nums) {
    let prefix= new Array(nums.length);
    prefix[0] = 1; // nothing before index 0
    
    for (let i = 1; i < nums.length; i++) {
      
       prefix[i]=(prefix[i-1]*nums[i-1])
      
    }
    
    return prefix;
}
let nums=[-1,1,0,-3,3]

let sufix=(sufixProducts(nums))
let prefix=(prefixProducts(nums))
let answer=[]
for(i=0;i<nums.length;i++){
  answer[i]=prefix[i]*sufix[i]
}
