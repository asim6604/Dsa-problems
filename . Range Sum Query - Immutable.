

let nums=[-2, 0, 3, -5, 2, -1]

class range{
   prefix=[]
  constructor(nums){
     for(let i=0;i<nums.length;i++){
    if(i===0){
      this. prefix[i]=0+nums[i]
    }
    else{
      this.prefix[i]=this.prefix[i-1]+nums[i]
    }
   
  }
    
    
  }
  calculate(left,right){
    console.log(this.prefix)
    let answer=0;
    if(left===0){
       return this.prefix[right]
    }
    else{  answer=this.prefix[right]-this.prefix[left-1]}
     
      return answer;
    }
}

let obj=new range(nums);
let result=obj.calculate(2,5)
console.log(result)
